# Runtime
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
COMMIT_SHA=local

# Private investor demo. When blank in development, access is allowed locally.
DEMO_ACCESS_CODE=replace-with-a-private-code
DEMO_SESSION_SECRET=replace-with-at-least-32-random-characters

# Gemini images are sent only for recognition and are never persisted by this app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
RECOGNITION_CONFIDENCE_THRESHOLD=0.72
FOCUSED_RECOGNITION_CONFIDENCE_THRESHOLD=0.58

# Supabase. The service role key is server-only and must never use NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional public metadata
NEXT_PUBLIC_DEMO_LABEL=Latvia investor demo
