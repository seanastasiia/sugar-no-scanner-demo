# Runtime
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
COMMIT_SHA=local
DEMO_ACCESS_CODE=
DEMO_SESSION_SECRET=
# Optional. Defaults to 10 attempts/minute per client.
DEMO_AUTH_RATE_LIMIT=10

# Access-code protected scanner. Gemini frames are transient and are never persisted by this app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Optional dedicated live-recognition override. The default is tuned for low-latency shelf scans.
GEMINI_RECOGNITION_MODEL=gemini-3.5-flash
GEMINI_RECOGNITION_TIMEOUT_MS=15000
# Optional separate model for cited Google Search nutrition enrichment.
GEMINI_WEB_NUTRITION_MODEL=gemini-3.7-flash
# Google Search grounding rejects deadlines below 10 seconds. Defaults to 12 seconds.
GEMINI_WEB_NUTRITION_TIMEOUT_MS=12000
RECOGNITION_CONFIDENCE_THRESHOLD=0.72
FOCUSED_RECOGNITION_CONFIDENCE_THRESHOLD=0.58
RECOGNITION_RATE_LIMIT=36
RECOGNITION_RATE_WINDOW_SECONDS=60

# Supabase. The service role key is server-only and must never use NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Reproducible catalog syncs. Set both limits to 0 for a resumable full configured-scope run.
RETAILER_SYNC_LIMIT=10
RETAILER_SYNC_MAX_FETCHES=80
RETAILER_SYNC_REQUEST_SPACING_MS=450
RETAILER_SYNC_CONCURRENCY=4
RETAILER_SYNC_CHECKPOINT_EVERY=250
RETAILER_SYNC_RESUME=1
# Comma-separated Rimi top-level category slugs. Use `all` only for an approved whole-store crawl.
RETAILER_SYNC_RIMI_CATEGORIES=gala-zivis-un-gatava-kulinarija,piena-produkti-un-olas,maize-un-konditoreja,saldetie-edieni,iepakota-partika,saldumi-un-uzkodas,dzerieni
CATALOG_CHECKED_AT=

# Local composition pilot sync: dry-run unless --apply; at most 100 per category.
SHELF_PILOT_PER_CATEGORY=20
# Optional comma-separated canonical retailer IDs for a narrow exact-source refresh.
SHELF_PILOT_IDS=

# OFF bulk importer accepts an official .jsonl or .jsonl.gz path/URL. The full
# export is large; use a local downloaded file in CI or a scheduled data job.
OFF_BULK_INPUT=
# Comma-separated licensed bulk scope. Latvia writes the reproducible Latvia
# layer; multi-market runs write the separate regional layer unless overridden.
OFF_BULK_MARKETS=latvia
OFF_BULK_LIMIT=0
OFF_BULK_FETCH_TIMEOUT_MS=1800000

# Bounded Latvia bootstrap through the official structured API. Production-scale
# refreshes should continue to use the bulk job above.
OFF_LATVIA_LIMIT=500
OFF_LATVIA_PAGE_SIZE=100
OFF_LATVIA_REQUEST_SPACING_MS=6500
OFF_API_BASE_URL=https://world.openfoodfacts.org
OFF_API_FALLBACK_URL=https://world.openfoodfacts.net
