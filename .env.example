# Runtime
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
COMMIT_SHA=local

# Public camera-first scanner. Gemini frames are transient and are never persisted by this app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Optional separate model for cited Google Search nutrition enrichment.
GEMINI_WEB_NUTRITION_MODEL=gemini-3.7-flash
RECOGNITION_CONFIDENCE_THRESHOLD=0.72
FOCUSED_RECOGNITION_CONFIDENCE_THRESHOLD=0.58
RECOGNITION_RATE_LIMIT=36
RECOGNITION_RATE_WINDOW_SECONDS=60

# Supabase. The service role key is server-only and must never use NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Reproducible catalog syncs. Full retailer syncs are intentionally slow and low-concurrency.
RETAILER_SYNC_LIMIT=10
RETAILER_SYNC_MAX_FETCHES=80
RETAILER_SYNC_REQUEST_SPACING_MS=450
CATALOG_CHECKED_AT=

# OFF bulk importer accepts an official .jsonl or .jsonl.gz path/URL. The full
# export is large; use a local downloaded file in CI or a scheduled data job.
OFF_BULK_INPUT=
OFF_BULK_LIMIT=0

# Bounded Latvia bootstrap through the official structured API. Production-scale
# refreshes should continue to use the bulk job above.
OFF_LATVIA_LIMIT=500
OFF_LATVIA_PAGE_SIZE=100
OFF_LATVIA_REQUEST_SPACING_MS=500
OFF_API_BASE_URL=https://world.openfoodfacts.org
OFF_API_FALLBACK_URL=https://world.openfoodfacts.net
