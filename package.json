{
  "name": "sugar-no-scanner-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep \"public root opens|sample shelf photo highlights|checkout photo recognizes|automatic online enrichment\"",
    "check:fast": "npm run lint && npm run typecheck && npm test",
    "verify:catalog": "npm run catalog:validate && npm run catalog:validate:barbora-coverage && npm run catalog:validate:shelf-pilot",
    "verify": "npm run lint && npm run typecheck && npm test && npm run verify:catalog && npm run build",
    "catalog:sync": "tsx scripts/sync-barbora.ts",
    "catalog:sync:shelf-pilot": "tsx scripts/sync-personal-shelf-evidence.ts",
    "catalog:sync:shelf-demo": "tsx scripts/sync-shelf-demo-evidence.ts",
    "catalog:sync:shelf-batch": "tsx scripts/sync-personal-shelf-batch.ts",
    "catalog:audit:personal-fit": "tsx scripts/audit-personal-shelf-catalog.ts",
    "catalog:report:personal-fit": "tsx scripts/report-personal-shelf-quality.ts",
    "catalog:validate:shelf-pilot": "tsx scripts/validate-personal-shelf-evidence.ts",
    "supabase:seed:shelf-pilot": "tsx scripts/seed-personal-shelf-evidence.ts",
    "catalog:sync:barbora-index": "tsx scripts/sync-barbora-index.ts",
    "catalog:sync:barbora-nutrition": "tsx scripts/sync-barbora-nutrition-index.ts",
    "catalog:sync:rimi": "RETAILER_SYNC_SOURCE=rimi tsx scripts/sync-retailer-catalog.ts",
    "catalog:sync:livin": "RETAILER_SYNC_SOURCE=livin tsx scripts/sync-retailer-catalog.ts",
    "catalog:sync:livinn": "RETAILER_SYNC_SOURCE=livinn tsx scripts/sync-retailer-catalog.ts",
    "catalog:sync:off-latvia": "tsx scripts/sync-open-food-facts-latvia.ts",
    "catalog:import:off": "tsx scripts/import-open-food-facts-bulk.ts",
    "catalog:generate:sources": "tsx scripts/generate-catalog-sources.ts",
    "catalog:validate": "tsx scripts/validate-catalog.ts",
    "catalog:validate:barbora-coverage": "tsx scripts/validate-barbora-coverage.ts",
    "catalog:preload:nutrition": "tsx scripts/preload-web-nutrition.ts",
    "benchmark:focus": "tsx scripts/benchmark-focus.ts",
    "benchmark:recognition": "node --import tsx scripts/benchmark-recognition.ts",
    "benchmark:models": "tsx scripts/benchmark-recognition-models.ts",
    "supabase:seed": "tsx scripts/seed-supabase.ts",
    "supabase:seed:external": "tsx scripts/seed-external-catalog.ts",
    "supabase:seed:livinn": "tsx scripts/seed-livinn-catalog.ts",
    "supabase:seed:external:dry-run": "tsx scripts/seed-external-catalog.ts --dry-run",
    "supabase:verify:external": "tsx scripts/verify-external-catalog.ts"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@supabase/supabase-js": "^2.112.3",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "^28.0.0",
    "sharp": "0.35.3",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
